<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qianhua.customer.mapper.SecurityInfoMapper">

    <select id="findByStkCode" resultType="com.qianhua.customer.entity.SecurityInfoRow">
        SELECT market, stk_code AS stkCode, stk_name AS stkName
        FROM security_info
        WHERE stk_code = #{stkCode}
    </select>
</mapper>
